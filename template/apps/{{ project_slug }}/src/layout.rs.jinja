use crate::router::Route;
use dioxus::prelude::*;

#[component]
pub fn Layout() -> Element {
  rsx! {
    div { class: "flex min-h-screen flex-col bg-background text-foreground",
      header { class: "border-b border-border",
        nav { class: "mx-auto flex w-full max-w-6xl items-center px-6 py-4",
          Link { to: Route::Home {}, class: "font-semibold text-foreground", {{ project_name | tojson }} }
        }
      }
      main { class: "grow", Outlet::<Route> {} }
      footer { class: "border-t border-border px-6 py-4 text-center text-sm text-muted-foreground",
        {{ project_name | tojson }}
      }
    }
  }
}
