use crate::api::db::models::{NewUserRow, UserRow};
use crate::api::db::schema::users;

pub async fn create_user(email: &str, password_hash: &str) -> Result<UserRow, ServerFnError> {
  let mut connection = connection().await?;
  diesel::insert_into(users::table)
    .values(NewUserRow { email, password_hash })
    .returning(UserRow::as_returning())
    .get_result(&mut connection)
    .await
    .map_err(ServerFnError::new)
}

pub async fn find_user_by_email(email: &str) -> Result<UserRow, ServerFnError> {
  let mut connection = connection().await?;
  users::table.filter(users::email.eq(email)).select(UserRow::as_select()).first(&mut connection).await.map_err(ServerFnError::new)
}
