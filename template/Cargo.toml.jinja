[workspace]
members = ["apps/{{ project_slug }}"]
resolver = "3"

[workspace.package]
authors = ["Jeremy Meek"]
edition = "2024"
rust-version = "1.99.0"
version = "0.1.0"

[workspace.dependencies]
dioxus = { version = "=0.7.10", features = ["router"{% if fullstack %}, "fullstack"{% endif %}] }
{% if "authentication" in capabilities %}argon2 = { version = "=0.6.0" }
{% endif %}{% if "websocket" in capabilities %}axum = { version = "=0.8.9" }
{% endif %}{% if "database" in capabilities %}diesel = { version = "=2.3.13", default-features = false, features = ["postgres"] }
diesel-async = { version = "=0.9.2", features = ["deadpool", "postgres"] }
{% endif %}{% if "charting" in capabilities %}dx-charming = { git = "https://github.com/Distortedlogic/dx-charming.git", branch = "main" }
{% endif %}{% if "websocket" in capabilities %}futures-util = { version = "=0.3.34" }
{% endif %}{% if "database" in capabilities or "authentication" in capabilities or "websocket" in capabilities %}serde = { version = "=1.0.229", features = ["derive"] }
{% endif %}{% if "websocket" in capabilities %}serde_json = { version = "=1.0.151" }
{% endif %}
[profile.release]
codegen-units = 1
lto = true
panic = "abort"
strip = true
{% if "web" in targets %}
[profile.wasm-dev]
inherits = "dev"
opt-level = 1

[profile.wasm-release]
inherits = "release"
opt-level = "z"
{% endif %}
{% if fullstack %}
[profile.server-dev]
inherits = "dev"
{% endif %}
{% if "mobile" in targets %}
[profile.android-dev]
inherits = "dev"
{% endif %}
[workspace.lints.rust]
unsafe_code = "deny"

[workspace.lints.clippy]
all = "warn"
