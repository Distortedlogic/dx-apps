set shell := ["bash", "-uc"]

default:
    @just --list

serve:
    dx serve --package {{ project_slug }} --platform {% if app_type == "fullstack" %}web{% elif app_type == "mobile" %}{{ mobile_target }}{% else %}{{ app_type }}{% endif %}

build:
    dx build --package {{ project_slug }} --platform {% if app_type == "fullstack" %}web{% elif app_type == "mobile" %}{{ mobile_target }}{% else %}{{ app_type }}{% endif %}
{% if app_type == "mobile" %}

android:
    dx serve --package {{ project_slug }} --platform android

ios:
    dx serve --package {{ project_slug }} --platform ios
{% endif %}

check:
    cargo check --workspace --all-targets --all-features
    dx check --package {{ project_slug }} --platform {% if app_type == "fullstack" %}web --fullstack{% elif app_type == "mobile" %}{{ mobile_target }}{% else %}{{ app_type }}{% endif %}

format:
    cargo fmt --all -- --check

lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings
