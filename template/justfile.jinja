set shell := ["bash", "-uc"]

default:
    @just --list

serve platform:
    dx serve --package {{ project_slug }} --platform {% raw %}{{ platform }}{% endraw %}

build platform:
    dx build --package {{ project_slug }} --platform {% raw %}{{ platform }}{% endraw %}

tailwind-check:
    pnpm exec tailwindcss -i apps/{{ project_slug }}/tailwind.css -o /dev/null

check platform: tailwind-check
    dx check --package {{ project_slug }} --platform {% raw %}{{ platform }}{% endraw %}{% if fullstack %} --fullstack{% endif %}
{% if "database" in capabilities %}
migrate:
    diesel migration run

migrate-revert:
    diesel migration revert

migration-gen name:
    diesel migration generate {% raw %}{{ name }}{% endraw %}
{% endif %}
format:
    cargo fmt --all -- --check

lint feature:
    cargo clippy --workspace --all-targets --no-default-features --features {% raw %}{{ feature }}{% endraw %} -- -D warnings
